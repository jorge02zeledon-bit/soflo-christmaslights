# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://soflochristmaslights.com

# Quote form delivery via Resend (https://resend.com). Leave unset to log
# submissions to the server console instead of emailing them.
RESEND_API_KEY=
QUOTE_TO_EMAIL=jorge01zeledon@gmail.com
# Must be a verified sender on your Resend account. The resend.dev default
# only delivers to the account owner's email.
QUOTE_FROM_EMAIL="SoFlo Christmas Lights <quotes@yourdomain.com>"
